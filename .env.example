# Copy this file to .env (which is never committed) and fill it in.
# Values arrive with the lessons that need them.

# L02: your group's Google Cloud project, given by the teaching team
GCP_PROJECT_ID=data-engineering-i1
GCP_REGION=europe-west1

# L03: credentials stay in the environment / local ADC, never in source code.
DATABASE_URL=
PG_SCHEMA=public
BRONZE_URI=gs://data-engineering-i1-group6/bronze
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=clickstream
CONSUMER_GROUP=group6-bronze-clickstream
KAFKA_BATCH_SIZE=200
KAFKA_FLUSH_SECONDS=5
# Optional path to an untracked TLS/SASL JSON file.
KAFKA_CLIENT_CONFIG=
