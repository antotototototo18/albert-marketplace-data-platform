# Copy to C:\de\l07\.env (next to docker-compose.yaml) and fill in. Never commit .env.
# The user id Airflow's containers run as. 50000 is the image's own default.
AIRFLOW_UID=50000
# Paths on YOUR machine, with forward slashes: the host's Docker resolves every mount.
HOST_DIR=C:/de/l07
GCLOUD_DIR=C:/Users/<you>/AppData/Roaming/gcloud
# This repository's orchestration/dags folder: Airflow's dags/ points at it.
DAGS_DIR="C:/<path to>/albert-marketplace-data-platform/orchestration/dags"
# The company database, on the albert-marketplace compose network (local defaults).
SOURCE_DATABASE_URL=postgresql://postgres:postgres@db:5432/marketplace
# Failure alert. Gmail needs an app password (myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# dbt writes <DBT_DATASET>_silver and _gold. group6 = the shared datasets;
# group6_l07_<name> = your own while testing.
DBT_DATASET=group6
